{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kinesis-360-mirror",
  "version": "0.1.0",
  "identifier": "com.agomez.kinesis-360-mirror",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kinesis 360 Mirror",
        "width": 1180,
        "height": 520,
        "minWidth": 560,
        "minHeight": 240,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "focus": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
